# Copy to .env.cloud and fill in (do not commit secrets).

# After: ./cloud_2_push_swr.sh
VLM_IMAGE=swr.cn-north-9.myhuaweicloud.com/sai-guon/vlm-server:v2.3

# Container HF_HOME (ModelArts / SFS)
HF_HOME=/mnt/dev/vlm/model_cache/huggingface
TRANSFORMERS_CACHE=/mnt/dev/vlm/model_cache/huggingface

# Host/SFS path mapped into the container HF_HOME
HF_CACHE=/mnt/dev/vlm/model_cache/huggingface

MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
HOST_PORT=8000
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=64

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_USE_FLASHINFER_SAMPLER=0

# SFS OBS import ownership (set in console, not compose):
#   用户ID = 1000
#   用户组ID = 100
